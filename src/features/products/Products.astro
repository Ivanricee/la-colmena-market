---
import { Icon } from 'astro-icon/components'
import ProductCard from './components/ProductCard.astro'
import { getProducts } from './products.api'
import type { Product } from './products.model'

const { productos, errorMessage } = (await getProducts()) as {
  productos: Product[]
  errorMessage: string
}

const QUICK_FILTERS = [
  { label: 'Miel', tag: 'miel' },
  { label: 'Cosméticos', tag: 'cosmeticos' },
  { label: 'Dulces', tag: 'dulces' },
  { label: 'Propóleo', tag: 'propoleo' },
  { label: 'Jarabes', tag: 'jarabe' },
  { label: 'Naturista', tag: 'naturista' },
]
---

{
  errorMessage ? (
    <section>
      <h1>Error</h1>
      <p>{errorMessage}</p>
    </section>
  ) : (
    <section
      x-data={`catalogHandler(${JSON.stringify(productos.map(({ title, tags }) => ({ title, tags })))}, ${JSON.stringify(Astro.url.pathname)})`}
      class="space-y-8"
    >
      <div class="relative max-w-7xl mx-auto px-0 sm:px-6 py-8">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-r from-honey-dark/35 to-honey-medium/15 blur-2xl opacity-50 rounded-2xl" />

          <div class="relative bg-gradient-to-r from-card/95 to-card/90 border border-primary/40 rounded-2xl shadow-2xl shadow-honey-dark/30">
            <div class="flex items-center gap-4 px-6 py-4">
              <div class="relative">
                <div class="absolute inset-0 bg-primary blur-md opacity-50 rounded-full" />
                <Icon name="lucide:search" size={20} class="relative w-6 h-6 text-primary" />
              </div>

              <label for="product-search" class="sr-only">
                Buscar productos
              </label>
              <input
                id="product-search"
                type="text"
                x-model="search"
                x-on:input="resetLimit()"
                placeholder="Buscar..."
                class="flex-1 bg-transparent text-honey-light placeholder-text-muted-foreground outline-none text-lg"
              />
              <button
                type="button"
                x-show="search.length > 0"
                x-on:click="clearSearch()"
                aria-label="Limpiar búsqueda"
                class="rounded-full p-2 text-muted-foreground transition-colors hover:bg-primary/10 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
              >
                <Icon name="lucide:x" size={20} class="w-5 h-5" />
              </button>
            </div>
          </div>
        </div>

        <div
          class="flex flex-wrap gap-2 pt-4"
          role="group"
          aria-label="Filtros rápidos de productos"
        >
          <button
            type="button"
            x-on:click="clearFilters()"
            x-bind:aria-pressed="!activeQuickFilter"
            x-bind:class="!activeQuickFilter ? 'border-primary bg-primary text-secondary' : 'border-border bg-transparent text-foreground hover:bg-primary/10'"
            class="rounded-full border px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            Todos
          </button>
          {QUICK_FILTERS.map((filter) => (
            <button
              type="button"
              x-on:click={`selectQuickFilter(${JSON.stringify(filter.tag)})`}
              x-bind:aria-pressed={`activeQuickFilter === ${JSON.stringify(filter.tag)}`}
              x-bind:class={`activeQuickFilter === ${JSON.stringify(filter.tag)} ? 'border-primary bg-primary text-secondary' : 'border-border bg-transparent text-foreground hover:bg-primary/10'`}
              class="rounded-full border px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              {filter.label}
            </button>
          ))}
        </div>
      </div>

      <ul class="grid auto-rows-[16rem] lg:auto-rows-[30rem] grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {productos.map((product, index) => (
          <li
            class="h-full"
            x-show={`shouldShow(${index})`}
            x-transition:enter="transition ease-in-out duration-200"
            x-transition:enter-start="opacity-5 transform scale-95"
            x-transition:enter-end="opacity-100 transform scale-100"
            x-transition:leave="transition ease-in-out duration-200"
            x-transition:leave-start="opacity-100 transform scale-100"
            x-transition:leave-end="opacity-5 transform scale-95"
          >
            <div class="group shadow-honey-dark/30 @container h-full overflow-hidden rounded-lg transition-all duration-500 hover:scale-[1.03] hover:shadow-2xl">
              <ProductCard product={product} />
            </div>
          </li>
        ))}
      </ul>
      <div x-show="limit < totalCount" class="flex justify-center w-full" x-intersect="loadMore()">
        Cargando mas...
      </div>
    </section>
  )
}
