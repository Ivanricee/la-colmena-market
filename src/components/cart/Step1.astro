---
import { Icon } from 'astro-icon/components'
import Card from '../ui/Card.astro'
import InputNumber from '../ui/InputNumber.astro'
import Button from '../ui/Button.astro'
---

<Card x-show="step === 1" class="bg-card" x-cloak>
  <div class="flex flex-col space-y-1.5 pb-6">
    <h3
      class="flex items-center gap-2 text-xl leading-none font-semibold tracking-tight sm:text-2xl"
    >
      <Icon name="lucide:package" size={20} class="h-5 w-5 text-primary" />
      Revisa tu pedido
    </h3>
  </div>
  <div class="p-0 sm:p-6 sm:pt-0 space-y-6">
    <template x-for="[id, product] in Object.entries(items)" :key="id">
      <div
        class="rounded-xl bg-muted/30 p-3 sm:grid grid-cols-[minmax(2,1fr)_auto]
      lg:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-4 sm:p-6"
      >
        <!--Img title price -->
        <div class="flex items-start gap-3 sm:items-center sm:gap-4">
          <div
            class="h-16 w-16 shrink-0 overflow-hidden rounded-lg bg-gradient-warm sm:h-20 sm:w-20"
          >
            <img
              x-bind:src="product.imgUrl"
              x-bind:alt="product.title"
              class="h-full w-full object-contain p-2"
            />
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="truncate font-semibold text-foreground" x-text="product.title"></h3>
            <p
              class="mt-1 text-sm text-muted-foreground"
              x-text="'$' + Number(product.price).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' c/u'"
            >
            </p>
          </div>
        </div>
        <!--Count & subtotal -->
        <div class="border-t border-border lg:border-0 lg:pt-0">
          <div
            class="space-y-8 sm:space-y-0 mt-3 grid gap-3 justify-between
             lg:mt-0 grid-cols-[auto_auto] items-center sm:gap-4 sm:border-0 sm:pt-0"
          >
            <div
              class="lg:w-28 flex h-16 justify-center items-end self-center m-0 w-[7rem] sm:w-52 sm:space-y-0"
            >
              <InputNumber x-text="product.quantity" :id="id" x-bind:id="id" />
            </div>
            <div class="flex justify-between gap-1 sm:gap-3 items-center sm:justify-end lg:gap-2">
              <div class="text-left sm:text-right sm:w-20">
                <p
                  class="text-base sm:text-lg font-bold text-foreground"
                  x-text="'$' + Number(product.price * product.quantity).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })"
                >
                </p>
              </div>
              <Button
                size="icon"
                variant="ghost"
                x-on:click="$store.cartStore.handleRemoveFromCart(id)"
                class="h-10 w-10 text-destructive hover:text-destructive"
                aria-label="Eliminar producto"
                title="Eliminar producto"
              >
                <div>
                  <Icon name="lucide:trash-2" size={18} />
                </div>
              </Button>
            </div>
          </div>
        </div>
      </div>
    </template>
  </div>
</Card>
